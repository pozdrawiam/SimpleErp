@page "/"
@using Se.Contracts.Features.Products
@using Se.Web.Client
@using Se.Web.Client.Shared
@inject ISeWebApiClient Api

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

@code 
{
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Api.Products.CreateAsync(new ProductCreateRequest("Abc"));

            Console.WriteLine($"Created product id: {response?.Id}");
        }
        catch (ApiValidationException e)
        {
            Console.WriteLine($"Error: {e.Errors.First().Value.First()}");
        }
    }
}
